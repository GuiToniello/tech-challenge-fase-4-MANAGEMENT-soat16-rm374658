@startuml
' Modelo de dominio da Management API (fase 4).
' A ordem de servico em si vive no OS Service (outro repositorio, banco proprio). Aqui fica so a
' referencia minima dela (OrdemServicoReferencia), alimentada por eventos do SQS (ADR-019 e ADR-020).
' O orcamento e o pagamento vivem no Billing (repo BILLING, banco proprio, ADR-021): a Management
' so envia os servicos com o preco no evento OrdemServicoValidada e debita o estoque no PagamentoAprovado.

class Cliente {
	+Id : Guid
	+NomeCompleto : string
	+Identificacao : string
	+Email : string?
}

class Veiculo {
	+Id : Guid
	+Placa : string
	+Marca : string
	+Modelo : string
	+Ano : int
	+Renavam : string
}

class Insumo {
	+Id : Guid
	+Nome : string
	+Fabricante : string
	+QuantidadeDisponivel : int
	+ValorUnitario : decimal
}

class Servico {
	+Id : Guid
	+Nome : string
	+Descricao : string
}

class ItemServico {
	+Quantidade : int
}

class OrdemServicoReferencia {
	+Id : Guid
	+ClienteId : Guid
	+VeiculoId : Guid
	+ServicoIds : Guid[]
	+Status : StatusOrdemServico
	+EstoqueDebitado : bool
}

Cliente "1" --> "0..*" Veiculo
Servico "1" *-- "0..*" ItemServico
ItemServico "*" --> "1" Insumo

OrdemServicoReferencia ..> Cliente : clienteId (validado)
OrdemServicoReferencia ..> Veiculo : veiculoId (validado)
OrdemServicoReferencia ..> Servico : servicoIds (validados)

@enduml
