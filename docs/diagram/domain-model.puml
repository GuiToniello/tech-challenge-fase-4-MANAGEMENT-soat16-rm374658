@startuml
' Modelo de dominio da Management API (fase 4).
' A ordem de servico em si vive no OS Service (outro repositorio, banco proprio). Aqui fica so a
' referencia minima dela (OrdemServicoReferencia), alimentada por eventos do SQS (ADR-019 e ADR-020).

class Cliente {
	+Id : Guid
	+NomeCompleto : string
	+Identificacao : string
	+Email : string?
}

class Veiculo {
	+Id : Guid
	+Placa : string
	+Marca : string
	+Modelo : string
	+Ano : int
	+Renavam : string
}

class Insumo {
	+Id : Guid
	+Nome : string
	+Fabricante : string
	+QuantidadeDisponivel : int
	+ValorUnitario : decimal
}

class Servico {
	+Id : Guid
	+Nome : string
	+Descricao : string
}

class ItemServico {
	+Quantidade : int
}

class OrdemServicoReferencia {
	+Id : Guid
	+ClienteId : Guid
	+VeiculoId : Guid
	+ServicoIds : Guid[]
	+Status : StatusOrdemServico
}

class Orcamento {
	+Id : Guid
	+DataGeracao : DateTime
	+ValorTotal : decimal
	+Status : StatusOrcamento
}

class OrcamentoServico {
	+ServicoId : Guid
	+NomeServico : string
	+ValorTotal : decimal
}

Cliente "1" --> "0..*" Veiculo
Servico "1" *-- "0..*" ItemServico
ItemServico "*" --> "1" Insumo

OrdemServicoReferencia ..> Cliente : clienteId (validado)
OrdemServicoReferencia ..> Veiculo : veiculoId (validado)
OrdemServicoReferencia ..> Servico : servicoIds (validados)

Orcamento "1" -- "1" OrdemServicoReferencia : Id = ordemServicoId
Orcamento "1" *-- "1..*" OrcamentoServico
OrcamentoServico "*" ..> "1" Servico : snapshot

@enduml
