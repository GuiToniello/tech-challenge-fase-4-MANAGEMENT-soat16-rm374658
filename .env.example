# SQS (eventos com o OS Service, o Billing e o Execução e Produção); no docker-compose o ElasticMQ faz o papel do SQS
ELASTICMQ_PORT=9324
SQS_FILA_CONSUMO=techchallenge-oficina-management.fifo
SQS_FILA_PUBLICACAO_OS_SERVICE=techchallenge-oficina-os-service.fifo
SQS_FILA_PUBLICACAO_BILLING=techchallenge-oficina-billing.fifo
SQS_FILA_PUBLICACAO_EXECUTION=techchallenge-oficina-execution.fifo
SQS_SERVICE_URL=http://elasticmq:9324

# DynamoDB local (historico de movimentacoes de estoque); a API cria a tabela ao subir. 8003 para nao conflitar com o DynamoDB local do Billing (8000), da Execucao (8001) e do OS Service (8002)
DYNAMODB_PORT=8003

REGISTRY_PREFIX=903936907231.dkr.ecr.us-east-1.amazonaws.com/
IMAGE_TAG=latest
