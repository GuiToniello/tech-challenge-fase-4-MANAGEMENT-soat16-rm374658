POSTGRES_PORT=5432

API_MANAGEMENT_PORT=7194
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

ALLOWED_HOSTS=*
LOG_LEVEL_DEFAULT=Information
LOG_LEVEL_ASPNETCORE=Warning
DATABASE_CONNECTION_STRING=Host=postgres;Port=5432;Database=oficina;Username=sa;Password=P@ssw0rd123
